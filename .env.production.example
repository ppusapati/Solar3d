# ML Learning System - Environment Configuration
# Copy to .env.production and fill in values

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_USER=solar3d
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
POSTGRES_DB=solar3d
POSTGRES_PORT=5432
DB_SSLMODE=disable

# ============================================================
# MinIO S3 Storage
# ============================================================
MINIO_ROOT_USER=solar3d
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY_ID=solar3d
MINIO_SECRET_ACCESS_KEY=CHANGE_ME_GENERATE_STRONG_PASSWORD

# ============================================================
# Compute Service
# ============================================================
COMPUTE_SERVICE_PORT=8081
COMPUTE_SERVICE_LOG_LEVEL=info
COMPUTE_SERVICE_WORKERS=4

# ============================================================
# Orchestration Service
# ============================================================
ORCHESTRATION_SERVICE_PORT=8082
ORCHESTRATION_SERVICE_LOG_LEVEL=info
ORCHESTRATION_SERVICE_WORKERS=4
COMPUTE_SERVICE_URL=http://compute-service:8081

# ============================================================
# ML Inference Bridge
# ============================================================
ML_INFERENCE_BRIDGE_PORT=3030
RUST_LOG=info
ML_MODEL_VERSION=1.0.0

# ============================================================
# Monitoring
# ============================================================
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d

GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# ============================================================
# Security
# ============================================================
ENVIRONMENT=production
ENABLE_HTTPS=false
CORS_ALLOWED_ORIGIN=*
AUTH_ENABLED=false

# ============================================================
# Training Configuration
# ============================================================
# Retraining cadence: daily, weekly, monthly
TRAINING_CADENCE=weekly

# Model deployment gates
DEPLOYMENT_CANARY_TRAFFIC_PERCENT=10
DEPLOYMENT_CANARY_DURATION_MINUTES=60
DEPLOYMENT_MIN_IMPROVEMENT_PERCENT=2.0
DEPLOYMENT_AUTO_ROLLBACK_ON_ERROR=true

# ============================================================
# Performance Tuning
# ============================================================
# Database connection pool
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# Feature schema validation
FEATURE_VALIDATION_ENABLED=true
FEATURE_SCHEMA_CACHE_TTL_SECONDS=3600

# Monitoring window
MONITORING_WINDOW_MINUTES=60
DRIFT_DETECTION_ENABLED=true
DRIFT_DETECTION_ALGORITHM=ks_test

# ============================================================
# Feature Flags
# ============================================================
ENABLE_CANARY_DEPLOYMENT=true
ENABLE_AUTO_ROLLBACK=true
ENABLE_DRIFT_DETECTION=true
ENABLE_AUDIT_LOGGING=true
ENABLE_FEATURE_CACHING=true
