# Solar3D Environment Configuration
# Copy to .env and set values before running docker-compose up

# PostgreSQL
POSTGRES_DB=solar3d
POSTGRES_USER=solar3d
POSTGRES_PASSWORD=          # REQUIRED: set a strong password
POSTGRES_PORT=5432

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=solar3d
MINIO_ROOT_PASSWORD=        # REQUIRED: set a strong password

# Database connection
DB_SSLMODE=disable          # Use 'require' in production

# Logging
LOG_LEVEL=info              # debug, info, warn, error

# CORS
CORS_ALLOWED_ORIGIN=*       # Set to your frontend domain in production (e.g., https://solar3d.example.com)

# Frontend
VITE_API_BASE_URL=http://localhost:8080
